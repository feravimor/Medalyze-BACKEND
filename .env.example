APP_ENV=local
APP_VERSION=dev
# Con Docker Compose el host de la base de datos es "postgres".
# Si ejecutas la API SIN Docker, cambia "postgres" por "localhost" en las dos URL siguientes.
DATABASE_URL=postgresql+psycopg://medalyze_app:medalyze_app@postgres:5432/medalyze
ALEMBIC_DATABASE_URL=postgresql+psycopg://medalyze:medalyze@postgres:5432/medalyze
JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
# Lista separada por comas (o una lista JSON).
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
